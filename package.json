{
  "name": "dsh-done-check",
  "version": "0.0.0",
  "description": "Executable acceptance checklists for DeepSeek Harness coding tasks: every \"done\" has a recorded check result, and results go stale when the code changes.",
  "type": "module",
  "license": "MIT",
  "author": "BeforeLanding",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "acceptance", "verification"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=22.19" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
