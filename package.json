{
  "name": "dsh-done-check",
  "version": "0.0.0",
  "description": "Executable acceptance checklists for DeepSeek Harness coding tasks: every \"done\" has a recorded check result, and results go stale when the code changes.",
  "type": "module",
  "license": "MIT",
  "author": "BeforeLanding",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeforeLanding/dsh-done-check.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "acceptance",
    "verification"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./plugin": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.5-rc.1 <0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/picomatch": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
